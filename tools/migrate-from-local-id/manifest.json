{
  "manifest_version": 3,
  "name": "Newtabber data rescue",
  "version": "1.0.0",
  "description": "One-off helper: exports Newtabber data saved under the old extension ID.",
  "browser_specific_settings": {
    "gecko": {
      "id": "newtabber@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  }
}
